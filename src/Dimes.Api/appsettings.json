{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Authentication is a per-deployment choice. Mode = "Local" (email + password) or "Oidc" (Keycloak).
  // Provide the site admin and (for Oidc) the provider settings via environment variables or a
  // non-committed appsettings.Production.json. The OIDC ClientSecretRef is resolved through the secret
  // store (Secrets:{ref} or an env var of that name) — never put the secret itself here.
  // "Auth": {
  //   "Mode": "Oidc",
  //   "SiteAdmin": { "Email": "admin@example.com" },
  //   "Oidc": {
  //     "Authority": "https://keycloak.example.com/realms/dimes",
  //     "ClientId": "dimes",
  //     "ClientSecretRef": "DIMES_OIDC_CLIENT_SECRET",
  //     "CallbackPath": "/signin-oidc",
  //     "Scopes": "openid email profile"
  //   }
  // },
  "Auth": {
    "Mode": "Local"
  },

  // Secret references. Provider configs (LLM keys, SCM tokens, notification credentials) and the OIDC
  // client secret store only a *reference name* in the database; this is where a name gets a value.
  //
  // Each kind of secret has its own section, and a reference can only ever resolve inside its own. This
  // is a privilege boundary: an LLM provider's reference name is typed into a form by any project
  // Maintainer, so if it resolved in the same namespace as the OIDC client secret, a Maintainer could
  // name that secret on a provider pointed at a host they control and have it sent there as a bearer
  // token. Put each secret under the section for what uses it:
  //   LLM providers          Secrets:Llm:<name>            env DIMES_LLM_<name>
  //   Notification channels  Secrets:Notification:<name>   env DIMES_NOTIFICATION_<name>
  //   SCM providers          Secrets:Scm:<name>            env DIMES_SCM_<name>
  //   OIDC client secret     Secrets:<name>                env <name>            (unprefixed)
  // Within a section, four routes are tried in order, so a name can be bound whichever way suits the
  // deployment (shown for LLM; the others differ only in the section/prefix):
  //   1. Secrets:Llm:<name>       — the literal value
  //   2. SecretFiles:Llm:<name>   — a path; Dimes reads the file and uses its contents
  //   3. env DIMES_LLM_<name>     — the literal value
  //   4. env DIMES_LLM_<name>_FILE — a path; Dimes reads the file (the convention Docker images use)
  // Use a file route for a credential you hold as a file rather than a string — a Google service-account
  // credentials JSON for Vertex AI is the main case (multi-line, embeds a PEM private key), as are Docker
  // secrets at /run/secrets/... and Kubernetes projected volumes. A file route also keeps a private key
  // out of the environment, where it shows up in process listings, crash dumps and child processes.
  // A configured path that cannot be read fails loudly when the secret is used (references live on DB
  // rows, so they resolve on demand rather than at startup) — it never degrades to a silent "no secret".
  // UPGRADING: references bound unprefixed before the sections existed no longer resolve. Move them into
  // the section for what uses them; a stale binding is reported as a warning in the server log naming the
  // exact setting to create. The OIDC client secret is unaffected — it stays unprefixed.
  // Never put a secret value in this committed file — use appsettings.Production.json or the environment.
  // "SecretFiles": {
  //   "Llm": {
  //     "DIMES_VERTEX_CREDENTIALS": "/run/secrets/vertex-service-account.json"
  //   }
  // },
  // Notes for Vertex AI specifically:
  //   - Its credential is a JSON *document*, so a value that isn't JSON can only be a path. The Vertex
  //     adapter therefore accepts the key file's absolute path as the plain value (route 1 or 3 above) and
  //     reads the file itself — the file routes work too but aren't required. This shortcut is Vertex-only:
  //     for a bearer-token provider "contents vs path" is genuinely ambiguous and the token is sent verbatim
  //     to the configured endpoint, so those types still require an explicit file route.
  //   - If you already set GOOGLE_APPLICATION_CREDENTIALS to your key file, just enable "Application
  //     Default Credentials" on the provider and skip the reference entirely — the Google library reads
  //     that variable itself. (Naming it as a reference no longer works: references resolve only inside
  //     their section, so it would have to be re-bound as DIMES_LLM_GOOGLE_APPLICATION_CREDENTIALS. ADC is
  //     the better answer anyway — nothing is stored and nothing is sent anywhere but Google.)

  // Cross-origin access for the capture SDK (dimes-capture-sdk). Only the anonymous observation
  // ingest endpoint honors these origins; every other endpoint stays same-origin. List the exact
  // origins (scheme + host + port) of host apps that embed the SDK from a different domain.
  // Credentials are never allowed. Unset/empty => no cross-origin access. Set via env as e.g.
  // Cors__AllowedOrigins__0=https://app.example.com  Cors__AllowedOrigins__1=https://other.example.com
  // "Cors": {
  //   "AllowedOrigins": [ "https://app.example.com" ]
  // }
}
